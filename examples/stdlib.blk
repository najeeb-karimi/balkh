# دری: نمونه‌هایی از کتابخانهٔ معیاری بلخ برای ریاضی، انتخاب تصادفی و تاریخ.
# پښتو: د ریاضي، تصادفي ټاکنې او نېټې لپاره د بلخ د معیاري کتابتون بېلګې.

از balkh.stdlib وارد ریاضی, تصادفی, زمان

چاپ("جذر ۸۱:", ریاضی.جذر(۸۱))
چاپول("د ۸۱ مربع ریښه:", ریاضی.مربع_ریښه(۸۱))

چاپ("انتخاب:", تصادفی.انتخاب(["بلخ"]))
چاپول("ټاکنه:", تصادفی.ټاکنه(["بلخ"]))

آغاز = زمان.تاریخ(۲۰۲۴, ۲, ۲۸)
فردا = آغاز + زمان.مدت(روز=۱)
چاپ("فردا:", زمان.قالب(فردا))

از balkh.stdlib وارد ریاضي, تصادفي, وخت
سبا = وخت.نېټه(۲۰۲۴, ۲, ۲۸) + وخت.موده(ورځې=۱)
چاپول("سبا:", وخت.بڼه(سبا))
