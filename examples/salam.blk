# دری: خوش‌آمدگویی به دری، پشتو و انگلیسی با زبان بلخ.
# پښتو: په بلخ ژبه په دري، پښتو او انګلیسي ښه راغلاست.

تابع خوش_آمدید(نام, زبان):
    اگر زبان == "دری":
        چاپ("سلام", نام, "! به زبان برنامه‌نویسی بلخ خوش آمدید.")
    وگرنه_اگر زبان == "پښتو":
        چاپول("سلام", نام, "! د بلخ پروګرامینګ ژبې ته ښه راغلاست.")
    وگرنه:
        چاپ("Hello", نام)

کاربران = [
    ("احمد", "دری"),
    ("زرغونه", "پښتو"),
    # دری: سطر انگلیسی را از چپ به راست بخوانید: نام، سپس زبان.
    # پښتو: انګلیسي کرښه له کیڼ نه ښي ته ولولئ: نوم، بیا ژبه.
    ("Sara", "English")
]

برای نام, زبان در کاربران:
    خوش_آمدید(نام, زبان)
