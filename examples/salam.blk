# سلام دنیا به زبان بلخ!

تابع خوش_آمدید(نام, زبان):
    اگر زبان == "دری":
        چاپ("سلام", نام, "! به زبان برنامه‌نویسی بلخ خوش آمدید.")
    وگرنه_اگر زبان == "پښتو":
        چاپول("سلام", نام, "! د بلخ پروګرامینګ ژبې ته ښه راغلاست.")
    وگرنه:
        چاپ("Hello", نام)

کاربران = [
    ("احمد", "دری"),
    ("زرغونه", "پښتو"),
    ("سارا", "English")
]

برای نام, زبان در کاربران:
    خوش_آمدید(نام, زبان)
