وارد random

عدد_مخفی = random.randint(۱, ۱۰)
چاپ("یک عدد بین ۱ تا ۱۰ حدس بزنید!")

ترڅو درست:
    حدس = عدد(ورودی("حدس شما: "))
    
    که حدس == عدد_مخفی:
        چاپ("آفرین! درست حدس زدید 🎉")
        توقف
    که_نه_نو حدس < عدد_مخفی:
        چاپ("عدد بزرگتر است ⬆️")
    که_نه:
        چاپ("عدد کوچکتر است ⬇️")
