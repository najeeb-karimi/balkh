# دری: بازی حدس عدد؛ یک عدد بین ۱ تا ۱۰ را حدس بزنید.
# پښتو: د شمېرې اټکل لوبه؛ له ۱ تر ۱۰ پورې یوه شمېره اټکل کړئ.

از balkh.stdlib وارد تصادفی

عدد_مخفی = تصادفی.عدد_صحیح(۱, ۱۰)
چاپ("یک عدد بین ۱ تا ۱۰ حدس بزنید!")

ترڅو درست:
    حدس = عدد(ورودی("حدس شما: "))
    
    که حدس == عدد_مخفی:
        چاپ("آفرین! درست حدس زدید 🎉")
        توقف
    که_نه_نو حدس < عدد_مخفی:
        چاپ("عدد بزرگتر است ⬆️")
    که_نه:
        چاپ("عدد کوچکتر است ⬇️")
