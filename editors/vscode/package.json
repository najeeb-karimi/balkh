{
  "name": "balkh-language",
  "displayName": "Balkh Language",
  "description": "Balkh syntax highlighting, RTL editing, and program execution for Dari and Pashto (.blk).",
  "version": "0.5.0",
  "publisher": "Balkh",
  "license": "MIT",
  "icon": "dist/balkh-logo.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.cjs",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "balkh",
    "dari",
    "pashto",
    "afghanistan"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [{ "id": "balkh-output", "title": "Balkh Output", "icon": "assets/output.svg" }]
    },
    "views": {
      "balkh-output": [{ "id": "balkh.output", "name": "Balkh Output", "type": "webview" }]
    },
    "commands": [{
      "command": "balkh.runFile",
      "title": "Run Balkh File",
      "category": "Balkh",
      "icon": "$(play)",
      "enablement": "isWorkspaceTrusted"
    }, {
      "command": "balkh.stopRun",
      "title": "Stop Running Program",
      "category": "Balkh",
      "icon": "$(debug-stop)",
      "enablement": "balkh.running"
    }],
    "menus": {
      "editor/title": [{
        "command": "balkh.stopRun",
        "when": "balkh.running",
        "group": "navigation@0"
      }],
      "editor/title/run": [{
        "command": "balkh.runFile",
        "when": "resourceExtname == .blk",
        "group": "navigation@0"
      }],
      "explorer/context": [{
        "command": "balkh.runFile",
        "when": "resourceExtname == .blk && !explorerResourceIsFolder",
        "group": "navigation"
      }]
    },
    "configuration": {
      "title": "Balkh",
      "properties": {
        "balkh.runInTerminal": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Run in a terminal instead of the right-aligned Balkh Output view with native input prompts. Use for programs that need terminal-specific or raw input behavior. Terminal RTL rendering depends on VS Code's terminal support."
        },
        "balkh.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python executable for Run Balkh File. Leave empty to use the workspace .venv/venv Python, then python on Windows or python3 elsewhere. Supply an executable path, without shell quotes or arguments."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "balkh.rtlEditor",
        "displayName": "Balkh RTL Editor",
        "selector": [
          {
            "filenamePattern": "*.blk"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "balkh",
        "aliases": [
          "Balkh",
          "بلخ"
        ],
        "extensions": [
          ".blk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "balkh",
        "scopeName": "source.balkh",
        "path": "./syntaxes/balkh.tmLanguage.json",
        "tokenTypes": {
          "meta.embedded.expression.balkh": "other"
        }
      }
    ]
  },
  "scripts": {
    "generate": "python scripts/generate-grammar.py",
    "check": "python scripts/generate-grammar.py --check",
    "pretest": "npm run check",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build-editor.cjs",
    "test:browser": "npm run build && node --test tests/browser.cjs",
    "vscode:prepublish": "npm test && npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --baseImagesUrl https://raw.githubusercontent.com/najeeb-karimi/balkh/main/editors/vscode"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.65.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "dompurify": "^3.4.18"
  }
}
