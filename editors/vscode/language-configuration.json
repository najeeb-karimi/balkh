{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "'",
      "'"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "folding": {
    "offSide": true
  },
  "wordPattern": "[^\\s`~!@#$%^&*()=+\\[\\]{}\\\\|;:'\\\",.<>/?-]+",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:غیرهمزمان|async)\\s+)?(?:وگرنه_اگر|که_نه_نو|except\\*|finally|بالاخره|except|تاوقتی|په_پای|class|match|while|دپاره|فنکشن|وگرنه|پرته\\*|که_نه|case|elif|else|with|بجز\\*|برای|تابع|ترڅو|تلاش|پرته|def|for|try|اگر|بجز|سره|صنف|هڅه|if|با|که)(?=\\s|:|\\(|$).*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:(?:وگرنه_اگر|که_نه_نو|except\\*|finally|بالاخره|except|په_پای|وگرنه|پرته\\*|که_نه|elif|else|بجز\\*|پرته|بجز)(?=\\s|:|\\(|$).*:|[\\]\\)}])"
  }
}
